<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2: temperature on top, the tower with the wind pills below. Text sizes and the picture are set to the real widget size in WindWidget.java. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_day"
    android:padding="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.3"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/w_temp" style="@style/WidgetText"
            android:textStyle="bold" android:includeFontPadding="false" />
        <TextView android:id="@+id/w_icon" style="@style/WidgetText"
            android:layout_marginStart="4dp" />
        <TextView android:id="@+id/w_pop" style="@style/WidgetText"
            android:layout_marginStart="8dp" android:maxLines="1" />
    </LinearLayout>
    <ImageView
        android:id="@+id/w_tower"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_label" />
</LinearLayout>
